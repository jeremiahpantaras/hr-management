# Emulator-only demo values for local development (safe to commit — no real project, no secrets).
# The "demo-" project-ID prefix makes it impossible for the Firebase tooling to touch a real project.
# This file must stay DEMO-ONLY. Real project values (when the time comes) belong in .env.development.local (NOT .env.local: .env.development outranks it),
# which is git-ignored. Run `npm run verify:env` to check that nothing overrides these.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-hr-leave.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-hr-leave
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_FIREBASE_EMULATORS=true
