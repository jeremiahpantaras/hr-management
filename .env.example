# Copy to .env.development.local (NOT .env.local — .env.development outranks it) and fill in values for a REAL Firebase project.
# These four values are the Firebase *web app* config. They are public by nature
# (they ship in the browser bundle) — security comes from Auth + Firestore Security Rules.
# NEVER put a service-account key or any private credential in a VITE_* variable.
#
# For local development, .env.development already provides emulator-only demo values,
# so .env.development.local is only needed when pointing at a real project.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 'true' connects Auth and Firestore to the local emulators (127.0.0.1:9099 / :8080).
# Must be 'false' (or omitted) for a real project.
VITE_USE_FIREBASE_EMULATORS=false
